FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai \
    CIPM_RUNTIME=local \
    CIPM_MOCK=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY apps ./apps
COPY agents ./agents
COPY domain ./domain
COPY adapters ./adapters
COPY sdk ./sdk
COPY mock ./mock
COPY knowledge ./knowledge
COPY workflows ./workflows
COPY ops ./ops

RUN pip install --no-cache-dir ".[ui]"

EXPOSE 8501

CMD ["streamlit", "run", "apps/console/app.py", "--server.address=0.0.0.0", "--server.port=8501"]