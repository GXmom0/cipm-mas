# 新疆棉田植保决策多智能体系统 环境变量样例（与 sdk/settings.py 字段一一对应）

# 运行形态：local / agent_runtime
CIPM_RUNTIME=local
# 演示模式：1 为零外部依赖，0 需填写 AgentArts 与 LLM 配置
CIPM_MOCK=1
# 登记用药目录来源：mock（内置演示）/ real（knowledge/real_registry.json）
CIPM_REGISTRY_SOURCE=mock
# 气象数据来源：mock（写死）/ openmeteo（Open-Meteo 实时，失败回退 mock 并记 DEGRADED）
CIPM_WEATHER_PROVIDER=mock

CIPM_API_BASE=http://127.0.0.1:8000
CIPM_API_PORT=8000
CIPM_UI_PORT=8501
# 幂等 pending 超时（秒）：超时置 expired 并允许同 key 重发
CIPM_IDEMPOTENCY_TTL_SECONDS=600

CIPM_DATA_DIR=./data
CIPM_AUDIT_DIR=./data/audit
CIPM_DB_URL=sqlite:///./data/cipm.db
CIPM_AUDIT_RETENTION_DAYS=730
CIPM_LOG_LEVEL=INFO

# 固定随机种子，保证演示数据集可复现
CIPM_MOCK_SEED=20261113

# 以下为云端运行时配置，Mock 模式下可留空
CIPM_AGENTARTS_ENDPOINT=
CIPM_AGENTARTS_PROJECT_ID=
CIPM_LLM_ENDPOINT=
CIPM_LLM_MODEL=
CIPM_LLM_API_KEY=
# LLM 调用超时（秒）、失败重试次数、采样温度
CIPM_LLM_TIMEOUT_SECONDS=30
CIPM_LLM_MAX_RETRIES=2
CIPM_LLM_TEMPERATURE=0.2

# 外部接入地址（OSS / MQTT / REST）
CIPM_IMAGE_OSS_ENDPOINT=
CIPM_IMAGE_OSS_BUCKET=
CIPM_MQTT_BROKER=
CIPM_MQTT_TOPIC_SENSOR=
CIPM_MQTT_TOPIC_ACTUATOR=
CIPM_DEVICE_REST_ENDPOINT=
CIPM_WEATHER_ENDPOINT=
CIPM_CALENDAR_ENDPOINT=
CIPM_REGISTRY_ENDPOINT=